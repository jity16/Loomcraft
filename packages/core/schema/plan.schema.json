{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loomcraft.dev/schema/plan-v1.json",
  "title": "LoomcraftPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "revision", "steps"],
  "properties": {
    "goal": {"type": "string", "minLength": 1, "maxLength": 2000},
    "summary": {"type": "string", "maxLength": 2000},
    "revision": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "reason": {"type": ["string", "null"], "maxLength": 2000},
    "analysis_profile": {"type": ["string", "null"], "maxLength": 500},
    "metadata": {"type": "object"},
    "objectives": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/objective"}},
    "analysis_coverage": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/coverage"}},
    "steps": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/step"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "kind": {"enum": ["answer", "capability", "workflow", "dynamic", "review"]},
        "depends_on": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/id"}},
        "capability": {"type": ["string", "null"], "maxLength": 160},
        "description": {"type": "string", "maxLength": 1000},
        "status": {"enum": ["pending", "ready", "running", "waiting_approval", "succeeded", "failed", "skipped", "cancelled"]},
        "summary": {"type": ["string", "null"], "maxLength": 2000},
        "execution": {"type": ["object", "null"]},
        "retry": {"$ref": "#/$defs/retry"},
        "timeout_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "on_failure": {"enum": ["stop", "continue", "require_approval"]},
        "metadata": {"type": "object"},
        "attempts": {"type": "integer", "minimum": 0, "maximum": 1000}
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 0, "maximum": 20},
        "backoff_seconds": {"type": "number", "minimum": 0, "maximum": 3600},
        "backoff_multiplier": {"type": "number", "minimum": 1, "maximum": 10},
        "max_backoff_seconds": {"type": "number", "minimum": 0, "maximum": 86400}
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "question": {"type": "string", "minLength": 1, "maxLength": 1000},
        "status": {"type": ["string", "null"], "enum": ["planned", "executed", "not_estimable", "blocked", "deferred_by_scope", null]},
        "estimand": {"type": "string", "maxLength": 500},
        "independent_unit": {"type": "string", "maxLength": 300},
        "expected_outputs": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 300}},
        "method_families": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 300}},
        "validation_requirements": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 300}}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective_id", "status", "reason"],
      "properties": {
        "objective_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["planned", "executed", "not_estimable", "blocked", "deferred_by_scope"]},
        "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
        "selected_method": {"type": ["string", "null"], "maxLength": 300},
        "step_ids": {"type": "array", "maxItems": 12, "items": {"$ref": "#/$defs/id"}},
        "artifact_refs": {"type": "array", "maxItems": 12, "items": {"type": "string", "maxLength": 300}},
        "next_action": {"type": ["string", "null"], "maxLength": 500}
      }
    }
  }
}
